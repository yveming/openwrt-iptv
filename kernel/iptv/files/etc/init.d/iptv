#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

START=19
USE_PROCD=1

log_fail() {
	logger -t iptv -p daemon.err "$*"
	echo "iptv: $*" >&2
}

validate_ifname() {
	local name="$1"

	[ -n "$name" ] || return 1
	[ "${#name}" -le 15 ] || return 1

	case "$name" in
		*[!A-Za-z0-9_.:-]*) return 1 ;;
	esac

	return 0
}

validate_vid() {
	local vid="$1"

	case "$vid" in
		''|*[!0-9]*) return 1 ;;
	esac

	[ "$vid" -ge 1 ] && [ "$vid" -le 4094 ]
}

load_config() {
	config_load iptv
	config_get_bool ENABLED config enabled 0
	config_get UPLINK config uplink pon0
	config_get NAME config name itv
	config_get SERVICE_VID config service_vid
	config_get MCAST_VID config mcast_vid
	config_get MACADDR config macaddr
}

device_exists() {
	[ -n "$NAME" ] && [ -e "/sys/class/net/$NAME" ]
}

lower_matches() {
	[ "$(cat "/sys/class/net/$NAME/iflink" 2>/dev/null)" = \
	  "$(cat "/sys/class/net/$UPLINK/ifindex" 2>/dev/null)" ]
}

destroy_device() {
	device_exists || return 0
	ip link del "$NAME" 2>/dev/null
}

write_vids() {
	printf '%s %s\n' "$SERVICE_VID" "$MCAST_VID" \
		> "/sys/class/net/$NAME/vids" || {
		log_fail "cannot write VLANs $SERVICE_VID/$MCAST_VID to $NAME (current: $(cat "/sys/class/net/$NAME/vids" 2>/dev/null))"
		return 1
	}
}

configure_device() {
	local err

	if [ ! -d /sys/module/iptv ] && ! modprobe iptv 2>/dev/null; then
		log_fail "cannot load the iptv module"
		return 1
	fi

	if device_exists && lower_matches; then
		write_vids || return 1
	else
		destroy_device
		if ! err=$(ip link add dev "$NAME" link "$UPLINK" type iptv 2>&1); then
			log_fail "cannot create $NAME on $UPLINK: $err"
			return 1
		fi
		write_vids || return 1
	fi

	if [ -n "$MACADDR" ]; then
		if ! err=$(ip link set "$NAME" address "$MACADDR" 2>&1); then
			log_fail "cannot set MAC address $MACADDR on $NAME: $err"
			return 1
		fi
	fi

	if ! err=$(ip link set "$NAME" up 2>&1); then
		log_fail "cannot bring up $NAME: $err"
		return 1
	fi

	logger -t iptv "$NAME up: uplink=$UPLINK service_vid=$SERVICE_VID mcast_vid=$MCAST_VID${MACADDR:+ macaddr=$MACADDR}"
}

config_iptv() {
	load_config

	if [ "$ENABLED" -ne 1 ]; then
		if device_exists; then
			if destroy_device; then
				logger -t iptv "disabled, removed $NAME"
			else
				log_fail "cannot remove $NAME"
			fi
		fi
		return 0
	fi

	validate_ifname "$UPLINK" || {
		log_fail "invalid uplink device name '$UPLINK'"
		return 1
	}
	validate_ifname "$NAME" || {
		log_fail "invalid device name '$NAME'"
		return 1
	}
	[ "$NAME" != "$UPLINK" ] || {
		log_fail "device name '$NAME' must differ from uplink"
		return 1
	}
	validate_vid "$SERVICE_VID" || {
		log_fail "invalid service VLAN '$SERVICE_VID' (expected 1-4094)"
		return 1
	}
	validate_vid "$MCAST_VID" || {
		log_fail "invalid multicast VLAN '$MCAST_VID' (expected 1-4094)"
		return 1
	}
	[ "$SERVICE_VID" != "$MCAST_VID" ] || {
		log_fail "service and multicast VLAN must differ (both '$SERVICE_VID')"
		return 1
	}
	[ -e "/sys/class/net/$UPLINK" ] || {
		log_fail "uplink '$UPLINK' was not found"
		return 1
	}

	configure_device
}

start_service() {
	config_iptv
}

reload_service() {
	config_iptv
}

service_triggers() {
	procd_add_reload_trigger "iptv"
}
