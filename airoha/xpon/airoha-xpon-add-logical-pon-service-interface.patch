+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef _AIROHA_XPON_SERVICE_H_
+#define _AIROHA_XPON_SERVICE_H_
+
+#include <linux/types.h>
+#include <linux/device.h>
+
+struct airoha_xpon;
+struct sk_buff;
+
+int airoha_xpon_service_configure(struct airoha_xpon *xpon, const char *name,
+				  u16 service_vid, u16 mcast_vid);
+void airoha_xpon_service_destroy(struct airoha_xpon *xpon);
+void airoha_xpon_service_set_link(struct airoha_xpon *xpon, bool ready);
+bool airoha_xpon_service_rx(void *priv, struct sk_buff *skb, u16 vid);
+ssize_t airoha_xpon_service_show(struct airoha_xpon *xpon, char *buf);
+
+#endif /* _AIROHA_XPON_SERVICE_H_ */
