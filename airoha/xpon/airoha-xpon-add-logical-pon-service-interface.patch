 	return ret ? ret : count;
 }
+
+static ssize_t service_show(struct device *dev, struct device_attribute *attr,
+			    char *buf)
+{
+	struct airoha_xpon *xpon = dev_get_drvdata(dev);
+
+	return airoha_xpon_service_show(xpon, buf);
+}
+
+static ssize_t service_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct airoha_xpon *xpon = dev_get_drvdata(dev);
+	char name[IFNAMSIZ];
+	unsigned int service_vid, mcast_vid;
+	int ret;
+
+	if (sysfs_streq(buf, "clear")) {
+		airoha_xpon_service_destroy(xpon);
+		return count;
+	}
+
+	if (sscanf(buf, "%15s %u %u", name, &service_vid, &mcast_vid) != 3)
+		return -EINVAL;
+
+	ret = airoha_xpon_service_configure(xpon, name, service_vid,
+					    mcast_vid);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(service);
+
 static DEVICE_ATTR_RW(service_ready);
 
