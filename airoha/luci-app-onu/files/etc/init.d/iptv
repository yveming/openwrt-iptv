#!/bin/sh /etc/rc.common
# SPDX-License-Identifier: Apache-2.0

START=19
USE_PROCD=1

start_service() {
	# Create the logical service device before netifd starts, so a manually
	# configured bridge or L3 interface sees it during boot.
	/usr/libexec/iptv boot
}

reload_service() {
	/usr/libexec/iptv reload
}

service_triggers() {
	procd_add_reload_trigger "onu-iptv"
}
